from django.db import models
from django.contrib.auth.models import User

class UserProfile(models.Model):
    user = models.OneToOneField(User, on_delete=models.CASCADE)
    level = models.IntegerField(default=1)
    experience = models.IntegerField(default=0)
    completed_missions = models.IntegerField(default=0)
    total_xp = models.IntegerField(default=0)
    achievements = models.IntegerField(default=0)
    streak_days = models.IntegerField(default=0)
    registration_date = models.DateTimeField(auto_now_add=True)
    last_active = models.DateTimeField(auto_now=True)
    
    def __str__(self):
        return f"{self.user.username} - Уровень {self.level}"
    
    class Meta:
        verbose_name = "Профиль пользователя"
        verbose_name_plural = "Профили пользователей"

class UserMission(models.Model):
    user = models.ForeignKey(User, on_delete=models.CASCADE)
    mission_name = models.CharField(max_length=200)
    mission_description = models.TextField()
    progress = models.IntegerField(default=0)  # в процентах
    lessons_completed = models.IntegerField(default=0)
    total_lessons = models.IntegerField(default=0)
    completed = models.BooleanField(default=False)
    started_at = models.DateTimeField(auto_now_add=True)
    completed_at = models.DateTimeField(null=True, blank=True)
    
    def __str__(self):
        return f"{self.user.username} - {self.mission_name}"
    
    class Meta:
        verbose_name = "Миссия пользователя"
        verbose_name_plural = "Миссии пользователей"

class UserActivity(models.Model):
    user = models.ForeignKey(User, on_delete=models.CASCADE)
    activity_type = models.CharField(max_length=100)
    activity_description = models.TextField()
    timestamp = models.DateTimeField(auto_now_add=True)
    
    def __str__(self):
        return f"{self.user.username} - {self.activity_type}"
    
    class Meta:
        verbose_name = "Активность пользователя"
        verbose_name_plural = "Активности пользователей"
        ordering = ['-timestamp']

# Сигналы для автоматического создания профиля при регистрации
from django.db.models.signals import post_save
from django.dispatch import receiver

@receiver(post_save, sender=User)
def create_user_profile(sender, instance, created, **kwargs):
    if created:
        UserProfile.objects.create(user=instance)

@receiver(post_save, sender=User)
def save_user_profile(sender, instance, **kwargs):
    if hasattr(instance, 'userprofile'):
        instance.userprofile.save()